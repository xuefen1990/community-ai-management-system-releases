# ===== 服务配置 =====
PORT=3000
NODE_ENV=production

# ===== JWT 密钥（生产环境务必修改为随机长字符串）=====
JWT_SECRET=change-this-to-a-random-long-secret-string
JWT_EXPIRES_IN=7d

# ===== 管理员初始账号 =====
ADMIN_PHONE=13800000000
ADMIN_PASSWORD=admin123456

# ===== 数据库路径 =====
DB_PATH=./data/backend.db

# ===== 软件更新文件存储目录 =====
UPDATE_FILES_DIR=./data/updates

# ===== AI 大模型默认配置 =====
# 支持任意 OpenAI 兼容接口：OpenAI、DeepSeek、通义千问、Moonshot 等
AI_DEFAULT_BASE_URL=https://api.deepseek.com/v1
AI_DEFAULT_API_KEY=sk-your-default-api-key
AI_DEFAULT_MODEL=deepseek-chat

# CORS 允许的来源（逗号分隔，* 表示允许所有）
CORS_ORIGINS=*
