# ===== 服务配置 =====
PORT=3000
HOST=127.0.0.1
NODE_ENV=production

# ===== JWT 密钥（生产环境必填，至少 32 字节随机生成；轮换会使旧令牌失效）=====
JWT_SECRET=your-random-jwt-secret-here
JWT_EXPIRES_IN=7d

# ===== 管理员初始账号 =====
ADMIN_PHONE=13800000000
ADMIN_PASSWORD=your-strong-admin-password-here

# ===== 数据库路径 =====
DB_PATH=./data/backend.db

# ===== 软件更新文件存储目录 =====
UPDATE_FILES_DIR=./data/updates

# ===== AI 大模型默认配置 =====
# 支持任意 OpenAI 兼容接口：OpenAI、DeepSeek、通义千问、Moonshot 等
AI_DEFAULT_BASE_URL=https://api.deepseek.com
AI_DEFAULT_API_KEY=your-api-key-here
AI_DEFAULT_MODEL=deepseek-v4-flash
# 新主账号默认永久 Token 额度；平台管理员也可在管理后台修改，已创建账号的额度不会自动覆盖
AI_DEFAULT_QUOTA_TOKENS=1000000

# CORS 允许的来源（生产环境必填；逗号分隔，不支持 *）
CORS_ORIGINS=https://your-domain.example
