{
  "name": "community-ai-development",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-electron.mjs",
    "dev:tools": "node scripts/dev-electron.mjs --devtools",
    "dev:setup": "npm ci && npm --prefix app ci && npm --prefix backend ci",
    "test": "npm --prefix app test",
    "build": "npm --prefix app run build:arm64",
    "build:arm64": "npm --prefix app run build:arm64",
    "deploy:website": "bash scripts/deploy-website.sh",
    "deploy:website:watch": "node scripts/watch-website.mjs",
    "deploy:website:watch:enable": "node scripts/enable-website-watch.mjs"
  },
  "engines": {
    "node": ">=20.13.0"
  },
  "devDependencies": {
    "electron": "^41.7.1"
  }
}
